---
import '@styles/global.css';

import type { HTMLAttributes } from 'astro/types';

import BaseHead, { type BaseHeadProps } from '@layouts/BaseHead/BaseHead.astro';

export type CSSTheme = 'default' | 'dark-theme';

interface Props extends Omit<HTMLAttributes<'head'>, 'title'>, BaseHeadProps {
  theme?: CSSTheme;
}

const { theme = 'default', seoProps, jsonLd, ...props }: Props = Astro.props;
---

<!doctype html>
<html data-theme={theme} lang='en' class='bg-primary' {...props}>
  <BaseHead seoProps={seoProps} jsonLd={jsonLd} />

  <body class=`min-h-dvh`>
    <slot />
  </body>
</html>

<style>
  /* https://www.digitalocean.com/community/tutorials/css-css-grid-holy-grail-layout */

  body {
    display: flex;
    flex-direction: column;
  }

  @media (width >= 768px) {
    body {
      display: grid;

      grid-template-areas:
        'header header header'
        'side-left main-content side-right'
        'footer footer footer';

      grid-template-columns: minmax(0, 1fr) 1280px minmax(0, 1fr);
      grid-template-rows: auto 1fr auto;
      column-gap: 10px;
    }

    /* will need to make a component for this, when decided what to use it for (maybe ads or navigation?) */
    .aside--left {
      grid-area: side-left;
      margin-left: 0.5rem;
    }

    /* will need to make a component for this, when decided what to use it for (maybe ads or navigation?) */
    .aside--right {
      grid-area: side-right;
      margin-right: 0.5rem;
    }
  }

  @media (max-width: 1300px) {
    body {
      grid-template-columns: 0 1fr 0;
      column-gap: 0;
    }

    .aside--left,
    .aside--right {
      display: none;
    }
  }
</style>
