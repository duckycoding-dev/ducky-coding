---
import type { HTMLAttributes } from 'astro/types';
import { Image } from 'astro:assets';
import { cn } from '@libs/cn';

import DuckyCodingLogo from '@assets/images/DuckyCoding_logo.png';
import HamburgerToggle from '@components/hamburger-toggle/HamburgerToggle.astro';
import Link from '@components/link/Link.astro';
import Navbar from '@components/navbar/Navbar.astro';
import { IMAGE_DENSITIES } from '@utils/globals';

export interface HeaderProps {}

export interface Props extends HTMLAttributes<'header'>, HeaderProps {}

const { class: className, ...props }: Props = Astro.props;

const currentPath = Astro.url.pathname;
---

<header
  style='view-transition-name: site-header'
  class={cn(
    'bg-primary-700 border-comic-thick border-secondary sticky top-0 z-10 [grid-area:header] border-x-0 border-t-0',
    className,
  )}
  {...props}
>
  <div
    class='mx-auto flex max-w-7xl items-center justify-between gap-x-8 px-4 py-2 md:px-8'
  >
    <HamburgerToggle
      id='nav-toggle'
      class='absolute z-20 shrink-0 md:hidden'
      variant={'small'}
    />
    <div class='mx-auto h-10.5 md:mx-0' aria-hidden='true'>
      <Link
        href={currentPath === '/' ? '/#hero' : '/'}
        variant='contained'
        class='rounded-full p-0 md:justify-start'
        id='logo'
        tabindex={-1}
      >
        <Image
          format={'avif'}
          alt={'DuckyCoding logo'}
          title={'DuckyCoding'}
          src={DuckyCodingLogo}
          width={38}
          densities={IMAGE_DENSITIES}
          class='max-w-none'
        />
      </Link>
    </div>
    <Navbar />
  </div>
</header>

<script>
  import { closeNav, isNavOpen, openNav } from '@utils/scripts/navDialog';
  import { initSwipeNavigation } from '@utils/scripts/swipeToToggleDialog';

  // Toggle button
  const toggle = document.getElementById('nav-toggle');
  if (toggle) {
    toggle.addEventListener('click', () => {
      if (isNavOpen()) {
        closeNav();
      } else {
        openNav();
      }
    });
  }

  // Backdrop click
  const backdrop = document.getElementById('nav-backdrop');
  backdrop?.addEventListener('click', closeNav);

  // ESC key (non-modal dialog doesn't handle ESC natively)
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && isNavOpen()) {
      closeNav();
    }
  });

  // Touch swipe
  initSwipeNavigation();

  // Touch tip
  if ('ontouchstart' in document.documentElement) {
    const scrollTip = document.getElementById('scroll-tip');
    scrollTip?.classList?.remove('hidden');
  }
</script>
