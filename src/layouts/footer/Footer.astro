---
import type { HTMLAttributes } from 'astro/types';
import { cn } from '@libs/cn';

import Link from '@components/link/Link.astro';
import GitHubIcon from '../../components/icons/github-icon/GitHubIcon.astro';
import InstagramIcon from '../../components/icons/instagram-icon/InstagramIcon.astro';
import LinkedInIcon from '../../components/icons/linkedin-icon/LinkedInIcon.astro';
import TikTokIcon from '../../components/icons/tiktok-icon/TikTokIcon.astro';
import XIcon from '../../components/icons/x-icon/XIcon.astro';
import YouTubeIcon from '../../components/icons/youtube-icon/YouTubeIcon.astro';

export interface FooterProps {}

interface Props extends HTMLAttributes<'footer'>, FooterProps {}

const { class: className, ...props }: Props = Astro.props;

const FIRST_PUBLICATION_YEAR = 2024;
const currentYear = new Date().getUTCFullYear();
const copyrightYears =
  currentYear === FIRST_PUBLICATION_YEAR
    ? `${FIRST_PUBLICATION_YEAR}`
    : `${FIRST_PUBLICATION_YEAR}–${currentYear}`;
---

<footer
  class={cn(
    'bg-primary-700 border-secondary grid gap-y-4 border-4 border-x-0 border-b-0 px-4 py-8 [grid-area:footer] md:px-8',
    className,
  )}
  {...props}
>
  <h2
    class='decoration-accent text-center text-2xl font-extrabold wrap-anywhere underline underline-offset-6'
  >
    Stay in touch
  </h2>

  <nav aria-label='DuckyCoding on social media' class='mx-auto'>
    <ul
      class='grid min-h-12 grid-cols-[repeat(3,50px)] place-items-center gap-x-6 gap-y-4 sm:grid-cols-[repeat(6,50px)]'
    >
      <li>
        <Link
          aria-label='DuckyCoding on GitHub'
          target='_blank'
          rel='noopener noreferrer'
          href='https://github.com/duckycoding-dev'
          variant='default'
          class='text-secondary'
        >
          <GitHubIcon size={50} aria-hidden='true' />
        </Link>
      </li>
      <li>
        <Link
          aria-label='DuckyCoding on X'
          target='_blank'
          rel='noopener noreferrer'
          href='https://x.com/ducky_coding'
          variant='default'
          class='text-secondary'
        >
          <XIcon size={50} aria-hidden='true' />
        </Link>
      </li>
      <li>
        <Link
          aria-label='Davide on LinkedIn'
          target='_blank'
          rel='noopener noreferrer'
          href='https://www.linkedin.com/in/davide-m-997874254/'
          variant='default'
          class='text-secondary'
        >
          <LinkedInIcon size={50} aria-hidden='true' />
        </Link>
      </li>
      <li>
        <Link
          aria-label='DuckyCoding on Instagram'
          target='_blank'
          rel='noopener noreferrer'
          href='https://www.instagram.com/ducky.coding/'
          variant='default'
          class='text-secondary'
        >
          <InstagramIcon size={50} aria-hidden='true' />
        </Link>
      </li>
      <li>
        <Link
          aria-label='DuckyCoding on TikTok'
          target='_blank'
          rel='noopener noreferrer'
          href='https://www.tiktok.com/@ducky.coding'
          variant='default'
          class='text-secondary'
        >
          <TikTokIcon size={50} aria-hidden='true' />
        </Link>
      </li>
      <li>
        <Link
          aria-label='DuckyCoding on YouTube'
          target='_blank'
          rel='noopener noreferrer'
          href='https://www.youtube.com/@ducky.coding'
          variant='default'
          class='text-secondary'
        >
          <YouTubeIcon size={50} aria-hidden='true' />
        </Link>
      </li>
    </ul>
  </nav>

  <div class='flex flex-col items-center justify-center wrap-anywhere'>
    <p><small>&copy; {copyrightYears} DuckyCoding</small></p>
    <p>
      <small>
        Built with
        <Link
          href='https://astro.build/'
          target='_blank'
          rel='noopener noreferrer'>Astro</Link
        >
      </small>
    </p>
  </div>
</footer>
