---
import type { HTMLAttributes } from 'astro/types';
import { cn } from '@libs/cn';
import { cva, type VariantProps } from 'cva';

const tagVariants = cva({
  base: 'text-secondary border-comic border-secondary font-bold',
  variants: {
    color: {
      accent: 'bg-accent',
      accent2: 'bg-accent2',
      accent3: 'bg-accent3',
      alternating: 'odd:bg-accent even:bg-accent2',
      none: '',
    },
    size: {
      sm: 'text-xs px-2 py-0.5 rounded-2xl',
      md: 'text-sm px-3 py-1 rounded-3xl',
      lg: 'text-base px-3 py-1 rounded-3xl',
    },
    shape: {
      pill: 'rounded-3xl',
      square: 'rounded-none',
    },
  },
  defaultVariants: {
    color: 'none',
    size: 'md',
    shape: 'pill',
  },
});

export type TagVariants = VariantProps<typeof tagVariants>;

interface Props extends Omit<HTMLAttributes<'div'>, 'color'>, TagVariants {}

const { class: className, color, size, shape, ...props }: Props = Astro.props;
---

<div class={cn(tagVariants({ color, size, shape }), className)} {...props}>
  <slot />
</div>
