---
import type { HTMLAttributes } from 'astro/types';
import { cn } from '@libs/cn';

import { getVisiblePages } from './get-visible-pages';

export interface PaginationProps {
  currentPage: number;
  totalPages: number;
  buildPageUrl: (page: number) => string;
}

interface Props extends HTMLAttributes<'nav'>, PaginationProps {}

const {
  currentPage,
  totalPages,
  buildPageUrl,
  class: className,
  ...props
}: Props = Astro.props;

const visiblePages = getVisiblePages(currentPage, totalPages);
const hasPrev = currentPage > 1;
const hasNext = currentPage < totalPages;
---

{
  totalPages > 1 && (
    <nav
      aria-label='Pagination'
      class={cn('flex flex-col items-center gap-1.5', className)}
      {...props}
    >
      <div class='flex items-center gap-1.5 md:gap-2'>
        {/* Previous arrow */}
        {hasPrev ? (
          <a
            href={buildPageUrl(currentPage - 1)}
            aria-label='Previous page'
            class='border-comic border-secondary bg-primary-600 shadow-comic hover:shadow-comic-lg active:shadow-comic-pressed rounded-lg px-3 py-2 font-bold transition-all hover:-translate-y-0.5 active:translate-y-0.5'
          >
            ←
          </a>
        ) : (
          <span
            aria-hidden='true'
            class='border-comic border-secondary bg-primary-600 rounded-lg px-3 py-2 font-bold opacity-35'
          >
            ←
          </span>
        )}

        {/* Page numbers */}
        {visiblePages.map((item) =>
          item === 'ellipsis' ? (
            <span aria-hidden='true' class='text-secondary px-1 opacity-50'>
              …
            </span>
          ) : item === currentPage ? (
            <span
              aria-current='page'
              class='border-comic border-secondary bg-accent rounded-lg px-3 py-2 text-sm font-bold md:text-base'
            >
              {item}
            </span>
          ) : (
            <a
              href={buildPageUrl(item)}
              data-astro-prefetch
              class='border-comic border-secondary bg-primary shadow-comic hover:shadow-comic-lg active:shadow-comic-pressed rounded-lg px-3 py-2 text-sm transition-all hover:-translate-y-0.5 active:translate-y-0.5 md:text-base'
            >
              {item}
            </a>
          ),
        )}

        {/* Next arrow */}
        {hasNext ? (
          <a
            href={buildPageUrl(currentPage + 1)}
            aria-label='Next page'
            class='border-comic border-secondary bg-primary-600 shadow-comic hover:shadow-comic-lg active:shadow-comic-pressed rounded-lg px-3 py-2 font-bold transition-all hover:-translate-y-0.5 active:translate-y-0.5'
          >
            →
          </a>
        ) : (
          <span
            aria-hidden='true'
            class='border-comic border-secondary bg-primary-600 rounded-lg px-3 py-2 font-bold opacity-35'
          >
            →
          </span>
        )}
      </div>

      <p class='text-secondary text-sm opacity-60'>
        Page {currentPage} of {totalPages}
      </p>
    </nav>
  )
}
