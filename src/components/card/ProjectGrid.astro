---
import type { HTMLAttributes } from 'astro/types';
import { cn } from '@libs/cn';

import ProjectCard from '@components/card/ProjectCard.astro';
import Link from '@components/link/Link.astro';
import type { Project } from '@data/projects';

export interface Props extends HTMLAttributes<'div'> {
  projects: Project[];
  /** How many cards are loaded eagerly: use it for above-the-fold grids. */
  eagerCount?: number;
  /** Renders the extra project links below each card. */
  showSecondaryLinks?: boolean;
  /** Prefers the shorter homepage copy over the canonical summary. */
  useHomeSummary?: boolean;
}

const {
  projects,
  eagerCount = 0,
  showSecondaryLinks = false,
  useHomeSummary = false,
  class: className,
  ...rest
} = Astro.props;

const origin = Astro.url.origin;
---

<div
  class={cn('grid grid-cols-1 gap-8 md:grid-cols-2 lg:grid-cols-3', className)}
  {...rest}
>
  {
    projects.map((project, index) => {
      const isInternal = project.projectUrl.startsWith(origin);
      return (
        <div class='flex flex-col gap-2'>
          <Link
            href={project.projectUrl}
            variant='unstyled'
            class='group focus:shadow-comic-xl active:shadow-comic block h-full rounded-xl transition-all duration-300 focus:-translate-y-0.5 active:translate-y-0.5'
            target={isInternal ? '_self' : '_blank'}
            rel={isInternal ? undefined : 'noopener noreferrer'}
          >
            <ProjectCard
              title={project.title}
              summary={
                useHomeSummary
                  ? (project.homeSummary ?? project.summary)
                  : project.summary
              }
              technologies={project.technologies}
              projectUrl={project.projectUrl}
              linkActionTitle={project.linkActionTitle}
              bannerImage={project.bannerImage}
              bannerImageClass={project.bannerImageClass}
              imageAlt={project.imageAlt ?? `Banner image for ${project.title}`}
              loading={index < eagerCount ? 'eager' : 'lazy'}
              fetchPriority={index < eagerCount ? 'high' : 'auto'}
            />
          </Link>
          {showSecondaryLinks && project.secondaryLinks && (
            <div class='flex flex-wrap justify-center gap-4 text-sm'>
              {project.secondaryLinks.map((link) => (
                <Link
                  href={link.href}
                  size='small'
                  target='_blank'
                  rel='noopener noreferrer'
                >
                  {link.label}
                </Link>
              ))}
            </div>
          )}
        </div>
      );
    })
  }
</div>

<style>
  @keyframes slideInUp {
    from {
      opacity: 0;
      transform: translateY(30px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  /* Stagger the cards as the grid enters the viewport */
  @media (min-width: 768px) {
    .grid > :nth-child(1) {
      animation: slideInUp 0.6s ease-out;
      animation-delay: 0.1s;
      animation-fill-mode: both;
    }
    .grid > :nth-child(2) {
      animation: slideInUp 0.6s ease-out;
      animation-delay: 0.2s;
      animation-fill-mode: both;
    }
    .grid > :nth-child(3) {
      animation: slideInUp 0.6s ease-out;
      animation-delay: 0.3s;
      animation-fill-mode: both;
    }
    .grid > :nth-child(4) {
      animation: slideInUp 0.6s ease-out;
      animation-delay: 0.4s;
      animation-fill-mode: both;
    }
  }

  @media (prefers-reduced-motion) {
    .grid > :nth-child(n) {
      animation: none;
    }
  }
</style>
