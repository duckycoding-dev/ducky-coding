---
import type { ImageMetadata } from 'astro';
import type { HTMLAttributes } from 'astro/types';
import { Image } from 'astro:assets';
import { cn } from '@libs/cn';

import DuckyCodingLogo from '@assets/images/DuckyCoding_logo.png';
import Card from '@components/card/Card.astro';
import Link from '@components/link/Link.astro';
import Tag from '@components/tag/Tag.astro';
import type { Post } from '@db/features/posts/posts.model';

export interface PostCardProps extends HTMLAttributes<'a'> {
  post: Post;
  tags: string[];
  bannerImage?: ImageMetadata | null;
  imageAlt?: string | null;
  loading?: 'eager' | 'lazy';
  fetchPriority?: 'high' | 'low' | 'auto';
  sizes?: string;
  widths?: number[];
}

interface Props extends PostCardProps {}

const {
  post,
  tags,
  bannerImage,
  class: className,
  loading = 'lazy',
  imageAlt,
  fetchPriority = 'auto',
  sizes,
  widths,
}: Props = Astro.props;
---

<Link
  variant='unstyled'
  href={`/posts/${post.slug}`}
  class={cn(
    'rounded-xl transition-all duration-300 focus:shadow-comic-xl active:shadow-comic focus:-translate-y-0.5 active:translate-y-0.5',
    className,
  )}
>
  <Card hover='none' class='card flex h-full flex-col'>
    <Image
      format={'avif'}
      src={bannerImage ?? DuckyCodingLogo}
      width={bannerImage ? bannerImage.width : DuckyCodingLogo.width}
      height={bannerImage ? bannerImage.height : DuckyCodingLogo.height}
      alt={imageAlt ?? 'Post banner image'}
      widths={widths}
      sizes={sizes}
      loading={loading}
      decoding={'async'}
      class='bg-primary-700 aspect-[16/9] w-full object-cover'
      fetchpriority={fetchPriority}
    />
    <footer
      class='border-secondary flex grow flex-col gap-2 border-t-4 pt-2.5 pb-4'
    >
      <h2 class='px-5 text-2xl font-black'>
        {post.title}
      </h2>
      <section>
        <p class='border-secondary px-5 text-base font-semibold'>
          <span
            >Written by: {
              post.author.toLowerCase() === 'duckycoding'
                ? 'DuckyCoding (me)'
                : post.author
            }</span
          >
        </p>
        <p class='px-5 text-sm italic'>
          Read time: {post.timeToRead}
          {post.timeToRead > 1 ? 'minutes' : 'minute'}
        </p>
        {
          post.createdAt ? (
            <p class='px-5 text-sm italic'>
              {new Date(post.createdAt).toLocaleDateString()}
            </p>
          ) : null
        }
      </section>
      <section
        class='tags border-secondary mt-auto flex flex-wrap justify-end gap-2 px-5 text-sm font-semibold'
      >
        {tags.map((tag) => <Tag color='alternating'>{tag}</Tag>)}
      </section>
    </footer>
  </Card>
</Link>

<style>
  @reference '@styles/global.css';
  .card {
    container-name: card;
    container-type: inline-size;
  }
  @container card (width > 400px) {
    .tags {
      @apply text-xl;
    }
  }
</style>
