---
import type { ImageMetadata } from 'astro';
import type { HTMLAttributes } from 'astro/types';
import { Image } from 'astro:assets';
import { cn } from '@libs/cn';

import Card from '@components/card/Card.astro';
import Link from '@components/link/Link.astro';
import { getEnvs } from '@utils/env';
import { resolveTopicAccent } from '@utils/topic-accent/topic-accent';
import { getImageWidths } from '../../utils/images/images';

// Matches the only grid this card renders in (`/topics`): one column, then two
// from `xs`, then `auto-fill minmax(200px, 1fr)` inside a 1216px content box,
// which settles at five ~227px cells. `p-4` takes 32px off each.
const IMAGE_SIZES = `
  (max-width: 479px) calc(100vw - 4rem),
  (max-width: 639px) calc(50vw - 3.25rem),
  200px
`;

export type TopicCardProps = HTMLAttributes<'a'> &
  (
    | {
        title: string;
        titleBackgroundColor?: `#${string}` | 'transparent';
        imageSrc?: undefined;
        imageAlt?: undefined;
        fetchPriority?: undefined;
        loading?: undefined;
        decoding?: undefined;
        slug: string;
        accentColor?: string;
      }
    | {
        title?: undefined;
        titleBackgroundColor?: undefined;
        imageSrc: string | ImageMetadata;
        imageAlt: string;
        fetchPriority?: 'high' | 'low' | 'auto';
        loading?: 'eager' | 'lazy';
        decoding?: 'async' | 'auto' | 'sync';
        slug: string;
        accentColor?: string;
      }
    | {
        title: string;
        titleBackgroundColor?: `#${string}` | 'transparent';
        imageSrc: string | ImageMetadata;
        imageAlt: string;
        fetchPriority?: 'high' | 'low' | 'auto';
        loading?: 'eager' | 'lazy';
        decoding?: 'async' | 'auto' | 'sync';
        slug: string;
        accentColor?: string;
      }
  );

type Props = TopicCardProps;

const {
  title,
  class: className,
  titleBackgroundColor = 'transparent',
  decoding = 'auto',
  loading = 'eager',
  fetchPriority = 'auto',
  imageSrc,
  imageAlt,
  slug,
  accentColor,
  ...props
}: Props = Astro.props;

const topicAccent = resolveTopicAccent(accentColor);
---

<Link
  variant='unstyled'
  href={slug && `${getEnvs().BASE_SITE_URL}/topics/${slug}`}
  class={cn(
    'rounded-xl transition-all duration-300 focus:shadow-comic-xl focus:-translate-y-0.5 active:translate-y-0.5 active:shadow-comic group',
    className,
  )}
  title={title}
  {...props}
>
  <Card hover='none' class='flex h-full flex-col'>
    {
      imageSrc && (
        <div class='aspect-square overflow-hidden'>
          {typeof imageSrc === 'string' ? (
            <Image
              format={'avif'}
              src={imageSrc}
              alt={imageAlt}
              loading={loading}
              decoding={decoding}
              class={`topic-card__image -z-1 aspect-square w-full object-contain p-4 transition-transform duration-300 group-hover:scale-110 group-focus:scale-110 group-active:scale-110`}
              width={200}
              height={200}
              widths={getImageWidths(200)}
              sizes={IMAGE_SIZES}
              fetchpriority={fetchPriority}
            />
          ) : (
            <Image
              format={'avif'}
              src={imageSrc}
              alt={imageAlt}
              loading={loading}
              decoding={decoding}
              class={`topic-card__image -z-1 aspect-square w-full object-contain p-4 transition-transform duration-300 group-hover:scale-110 group-focus:scale-110 group-active:scale-110`}
              widths={getImageWidths(imageSrc.width)}
              sizes={IMAGE_SIZES}
              fetchpriority={fetchPriority}
            />
          )}
        </div>
      )
    }
    {
      title ? (
        <h2 class='border-secondary border-4 border-x-0 p-2.5 text-center text-xl font-black'>
          {title.charAt(0).toUpperCase() + title.slice(1)}
        </h2>
      ) : null
    }
  </Card>
</Link>

<style define:vars={{ titleBackgroundColor, topicAccent }}>
  h2 {
    background-color: var(--titleBackgroundColor);
  }

  /* Derived from the topic's own brand colour. The 20% mix keeps the surface
     light enough for the black title bar and the logo to read against it. */
  .topic-card__image {
    background-color: color-mix(in oklab, var(--topicAccent) 20%, white);
  }
</style>
