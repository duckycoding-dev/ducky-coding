---
import { type ImageMetadata } from 'astro';
import { getCollection } from 'astro:content';
import type { ItemList } from 'schema-dts';

import BriefPostCard from '@components/card/BriefPostCard.astro';
import PostCard from '@components/card/PostCard.astro';
import HolyGrailLayout from '@layouts/holy-grail-layout/HolyGrailLayout.astro';
import { WEBSITE_FIRST_PUBLISHING_DATE, WEBSITE_ROOT } from '@utils/globals';
import { matchImageFromGlobImport } from '@utils/images/images';
import { DuckyCodingBlog } from '@utils/json-ld/blog';
import { buildBreadcrumb } from '@utils/json-ld/breadcrumb';
import { BLOG_ID, buildGraph } from '@utils/json-ld/graph';
import { DuckyCodingPerson } from '@utils/json-ld/person';
import { DuckyCodingPublisher } from '@utils/json-ld/publisher';
import { buildCollectionPage } from '@utils/json-ld/webpage';
import { DuckyCodingWebsite } from '@utils/json-ld/website';
import { serverLogger } from '@utils/logs/logger';
import { buildPageSeo } from '@utils/seo/page-seo';
import DuckIcon from '../components/icons/duck-icon/DuckIcon.astro';
import { PostsService } from '../db/features/posts/posts.service';

const postsCollection = (await getCollection('posts'))
  .map((entry) => ({
    id: entry.id,
    tags: entry.data.tags,
    status: entry.data.status,
  }))
  .filter((post) => post.status === 'published'); // in astro 5 "slug" became "id", which corresponds to the filename of the content file
const postsWithBannerImage = (
  await PostsService.getPostsWithBannerBySlugs(
    postsCollection.map((post) => post.id),
  )
).filter(
  (postWithBannerImage) => postWithBannerImage.post.status === 'published',
);

const images = import.meta.glob<{ default: ImageMetadata }>(
  `/src/assets/images/**/*.{jpeg,jpg,png,gif,webp,svg}`,
);

const processedPostsWithImages = (
  await Promise.all(
    postsWithBannerImage.map(async (post) => {
      let processedImage: ImageMetadata | undefined;
      const imageToFindPath = `${post.post.bannerImagePath}`;
      if (imageToFindPath) {
        processedImage = await matchImageFromGlobImport(
          images,
          imageToFindPath,
          serverLogger,
        );
      }

      const postTags =
        postsCollection.find((p) => p.id === post.post.slug)?.tags || [];

      return {
        ...post,
        processedBannerImage: processedImage ?? null,
        tags: postTags,
      };
    }),
  )
).sort((postA, postB) => {
  // First, sort by lastPostDate (descending)
  const dateA = postA.post.publishedAt ?? 0;
  const dateB = postB.post.publishedAt ?? 0;
  if (dateA > dateB) return -1;
  if (dateA < dateB) return 1;
  // If lastPostDate is equal, sort by title (ascending)
  const titleA = postA.post.title?.toLowerCase() ?? '';
  const titleB = postB.post.title?.toLowerCase() ?? '';
  return titleA.localeCompare(titleB);
});

const lastPostDateAsISOString = processedPostsWithImages[0]?.post.publishedAt
  ? new Date(processedPostsWithImages[0].post.publishedAt).toISOString()
  : WEBSITE_FIRST_PUBLISHING_DATE;

const featuredPosts: typeof processedPostsWithImages = []; // todo implmement featured posts logic when we have enough posts: we will also need to only fetch X number of posts to show in this page; if that number is reached, we need to show a text inviting the user to check the topics page for older content

const pageUrl = Astro.url.href;

const blogDescription =
  'Browse articles on web development — from TypeScript and Astro to frontend patterns and developer tooling. New posts published regularly.';

const postsItemList: ItemList = {
  '@type': 'ItemList',
  '@id': `${pageUrl}#posts`,
  name: "DuckyCoding's posts",
  numberOfItems: processedPostsWithImages.length,
  itemListElement: processedPostsWithImages.map(({ post }, index) => ({
    '@type': 'ListItem' as const,
    position: index + 1,
    url: `${WEBSITE_ROOT}/posts/${post.slug}`,
    name: post.title,
  })),
};

const blogPageJsonLd = {
  item: buildGraph([
    DuckyCodingWebsite,
    DuckyCodingPublisher,
    DuckyCodingPerson,
    DuckyCodingBlog,
    buildCollectionPage({
      pageUrl,
      name: "DuckyCoding's Blog",
      description: blogDescription,
      dateModified: lastPostDateAsISOString,
      hasBreadcrumb: true,
      mainEntityId: BLOG_ID,
    }),
    postsItemList,
    buildBreadcrumb([{ name: 'Blog', url: pageUrl }], pageUrl),
  ]),
};
---

<HolyGrailLayout
  seoProps={buildPageSeo({
    title: 'Blog',
    ogTitle: "DuckyCoding's blog",
    description:
      'Browse articles on web development — from TypeScript and Astro to frontend patterns and developer tooling. New posts published regularly.',
    pageUrl,
    keywords: 'DuckyCoding, web development, blog, articles, guides, posts',
    article: {
      publishedTime: WEBSITE_FIRST_PUBLISHING_DATE,
      modifiedTime: lastPostDateAsISOString,
      section: 'Web Development',
      authors: ['DuckyCoding', 'Davide'],
      tags: [
        'DuckyCoding',
        'web development',
        'blog',
        'articles',
        'guides',
        'posts',
      ],
    },
  })}
  jsonLd={blogPageJsonLd}
>
  <h1
    class='decoration-accent mb-2 text-center text-4xl font-extrabold underline underline-offset-4'
  >
    Welcome to my blog
  </h1>
  <p class='mb-8 text-center'>
    <small class='block italic'>
      Practical articles and guides about software development, with a focus on
      the web.
    </small>
  </p>
  {
    processedPostsWithImages.length > 0 ? (
      <div class={`grid-layout ${featuredPosts.length ? 'gap-8' : ''}`}>
        <section class='[grid-area:latest]'>
          <h2 class='border-comic border-secondary from-accent-200 to-accent2-200 shadow-comic mb-4 rounded-xl border-4 bg-gradient-to-br px-4 py-2 text-2xl font-extrabold'>
            Latest posts
          </h2>
          <ul class='grid gap-6'>
            {processedPostsWithImages.map(
              ({ post, image, tags, processedBannerImage }, i) => {
                return (
                  <li>
                    <PostCard
                      class='block'
                      widths={[300, 600, 900, 1200, 1500]}
                      sizes={
                        '(max-width: 511px) calc(100vw - 2rem), (max-width: 976px) 36vw, (max-width: 1300px) 24vw, 310px'
                      }
                      post={post}
                      tags={tags}
                      bannerImage={processedBannerImage || null}
                      loading={i < 4 ? 'eager' : 'lazy'}
                      fetchPriority={i < 4 ? 'high' : 'auto'}
                      imageAlt={image?.alt || 'Banner image for ' + post.title}
                    />
                  </li>
                );
              },
            )}
          </ul>
        </section>
        {featuredPosts.length > 0 ? (
          <section class='trending'>
            <h2 class='border-comic border-secondary from-accent-200 to-accent2-200 shadow-comic mb-4 rounded-xl border-4 bg-gradient-to-br px-4 py-2 text-2xl font-extrabold'>
              Featured
            </h2>
            <ol class='flex flex-col gap-4'>
              {featuredPosts.map(({ post, tags }) => (
                <li>
                  <BriefPostCard post={post} tags={tags}>
                    {post.title}
                  </BriefPostCard>
                </li>
              ))}
            </ol>
          </section>
        ) : null}
      </div>
    ) : (
      <>
        <h2 class='mb-4 text-center text-2xl font-extrabold text-balance md:text-left'>
          <span class='block'>No content has been published yet :'(</span>
          <span class='block'>I'm working hard on it!</span>
        </h2>
        <h3 class='flex items-center justify-center text-xl font-extrabold md:justify-start'>
          Please check again soon!
          <span>
            <DuckIcon class='h-8' />
          </span>
        </h3>
      </>
    )
  }
</HolyGrailLayout>

<style
  define:vars={{
    showFeaturedPosts: featuredPosts.length ? 'minmax(0, 0.75fr)' : 'auto',
  }}
>
  .grid-layout {
    display: grid;
    align-items: stretch;
    grid-template-areas: 'latest trending';

    grid-template-columns: minmax(0, 2fr) var(--showFeaturedPosts);
    grid-template-rows: auto 1fr;
  }
  @media (max-width: 976px) {
    .grid-layout {
      grid-template-columns: 1fr;
      grid-template-areas:
        'latest'
        'trending';
    }
    /* .trending {
      display: none;
    } */
  }
</style>
