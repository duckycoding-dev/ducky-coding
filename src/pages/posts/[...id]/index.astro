---
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import type { BlogPosting } from 'schema-dts';

import DuckyCodingLogo from '@assets/images/DuckyCoding_logo.png';
import Link from '@components/link/Link.astro';
import ScrollToTopButton from '@components/scroll-to-top-button/ScrollToTopButton.astro';
import Tag from '@components/tag/Tag.astro';
import type { Image as BannerImage } from '@db/features/images/images.model';
import { ImagesService } from '@db/features/images/images.service';
import { postsService } from '@db/features/posts/posts.service';
import { TopicsService } from '@db/features/topics/topics.service';
import HolyGrailLayout from '@layouts/holy-grail-layout/HolyGrailLayout.astro';
import MarkdownContent from '@layouts/markdown-content/MarkdownContent.astro';
import { WEBSITE_FIRST_PUBLISHING_DATE, WEBSITE_ROOT } from '@utils/globals';
import { getImageWidths, matchImageFromGlobImport } from '@utils/images/images';
import { DuckyCodingBlog } from '@utils/json-ld/blog';
import { buildBreadcrumb } from '@utils/json-ld/breadcrumb';
import { blogRef, buildGraph, orgRef } from '@utils/json-ld/graph';
import { AuthorPerson, DuckyCodingPerson } from '@utils/json-ld/person';
import { DuckyCodingPublisher } from '@utils/json-ld/publisher';
import { TopicThing } from '@utils/json-ld/thing';
import { buildWebPage } from '@utils/json-ld/webpage';
import { DuckyCodingWebsite } from '@utils/json-ld/website';
import { serverLogger } from '@utils/logs/logger';
import { buildPageSeo } from '@utils/seo/page-seo';

// 1. Generate a new path for every collection entry
export async function getStaticPaths() {
  const postsEntries = (await getCollection('posts')).filter(
    (post) => post.data.status === 'published',
  );

  // One query for every banner instead of one per post — each is a network
  // round trip against remote Turso during a production build.
  const bannerPaths = postsEntries
    .map((entry) => entry.data.bannerImagePath)
    .filter((imagePath): imagePath is string => imagePath !== undefined);

  const bannerImages: BannerImage[] =
    bannerPaths.length > 0
      ? await ImagesService.getImagesByPaths(bannerPaths)
      : [];

  const bannerImageByPath = new Map<string, BannerImage>(
    bannerImages.map((image) => [image.path, image]),
  );

  return postsEntries.map((entry) => {
    const bannerPath = entry.data.bannerImagePath;
    return {
      params: { id: decodeURI(entry.id) },
      props: {
        entry,
        bannerImage: bannerPath ? bannerImageByPath.get(bannerPath) : undefined,
      },
    };
  });
}
// 2. For your template, you can get the entry directly from the prop
const { entry, bannerImage } = Astro.props;

let processedImage: ImageMetadata | undefined;
const imageToFindPath = bannerImage?.path;
const images = import.meta.glob<{ default: ImageMetadata }>(
  `/src/assets/images/**/*.{jpeg,jpg,png,gif,webp,svg}`,
);
if (imageToFindPath) {
  processedImage = await matchImageFromGlobImport(
    images,
    imageToFindPath,
    serverLogger,
  );
}

const postFromDb = await postsService.getPostBySlug(entry.id); // in astro 5 "slug" became "id", which corresponds to the filename of the content file

const pageUrl = Astro.url.href;

const topicFromDb = await TopicsService.getTopic(entry.data.topicTitle);
const topicSlug = topicFromDb?.slug ?? entry.data.topicTitle.toLowerCase();

const publishedAt = new Date(
  postFromDb?.createdAt || WEBSITE_FIRST_PUBLISHING_DATE,
).toISOString();
const modifiedAt = new Date(
  postFromDb?.updatedAt ||
    postFromDb?.createdAt ||
    WEBSITE_FIRST_PUBLISHING_DATE,
).toISOString();

const author = AuthorPerson(entry.data.author);

const imageSource = processedImage ?? DuckyCodingLogo;
const imageIsBanner = processedImage !== undefined;
const imageContentUrl = new URL(imageSource.src, WEBSITE_ROOT).href;
const imageAlt = imageIsBanner
  ? bannerImage?.alt ||
    `Post banner cover related to "${entry.data.topicTitle}"`
  : "DuckyCoding's logo";

const blogPosting: BlogPosting = {
  '@type': 'BlogPosting',
  '@id': `${pageUrl}#post`,
  url: pageUrl,
  mainEntityOfPage: { '@id': pageUrl },
  headline: entry.data.title,
  description: entry.data.summary,
  author,
  publisher: orgRef(),
  datePublished: publishedAt,
  dateModified: modifiedAt,
  image: {
    '@type': 'ImageObject',
    url: imageContentUrl,
    contentUrl: imageContentUrl,
    width: `${imageSource.width}`,
    height: `${imageSource.height}`,
    description: imageAlt,
  },
  keywords: entry.data.tags.join(', '),
  articleSection: entry.data.topicTitle,
  inLanguage: entry.data.language || 'en',
  about: TopicThing({ title: entry.data.topicTitle, slug: topicSlug }),
  isPartOf: blogRef(),
  potentialAction: {
    '@type': 'ReadAction',
    target: {
      '@type': 'EntryPoint',
      urlTemplate: pageUrl,
    },
  },
};

const blogPostJsonLd = {
  item: buildGraph([
    DuckyCodingWebsite,
    DuckyCodingPublisher,
    DuckyCodingPerson,
    DuckyCodingBlog,
    buildWebPage({
      pageUrl,
      name: entry.data.title,
      description: entry.data.summary,
      datePublished: publishedAt,
      dateModified: modifiedAt,
      primaryImageUrl: imageIsBanner ? imageContentUrl : undefined,
      hasBreadcrumb: true,
      mainEntityId: `${pageUrl}#post`,
    }),
    blogPosting,
    buildBreadcrumb(
      [
        { name: 'Blog', url: `${WEBSITE_ROOT}/blog` },
        { name: entry.data.title, url: pageUrl },
      ],
      pageUrl,
    ),
  ]),
};
---

<HolyGrailLayout
  class='relative'
  seoProps={buildPageSeo({
    title: entry.data.title,
    description: entry.data.summary,
    pageUrl,
    keywords: entry.data.tags.join(', '),
    ogType: 'article',
    ...(processedImage && {
      image: {
        src: processedImage.src,
        width: processedImage.width,
        height: processedImage.height,
        format: processedImage.format,
        alt:
          bannerImage?.alt ||
          `Post banner cover related to "${entry.data.topicTitle}"`,
      },
    }),
    author:
      entry.data.author.toLowerCase() === 'duckycoding'
        ? 'Davide Milan'
        : entry.data.author,
    article: {
      publishedTime: new Date(
        postFromDb?.createdAt || WEBSITE_FIRST_PUBLISHING_DATE,
      ).toISOString(),
      modifiedTime: new Date(
        postFromDb?.updatedAt ||
          postFromDb?.createdAt ||
          WEBSITE_FIRST_PUBLISHING_DATE,
      ).toISOString(),
      section: entry.data.topicTitle,
      authors: [entry.data.author],
      tags: entry.data.tags,
    },
  })}
  jsonLd={blogPostJsonLd}
>
  <section
    class='from-accent-300 to-accent2-300 shadow-comic mx-auto grid items-center border-4 bg-linear-to-br px-4 py-4 lg:max-w-[80%]'
  >
    {
      bannerImage && processedImage ? (
        <Image
          format='avif'
          src={processedImage}
          alt={
            bannerImage.alt ??
            `Post banner cover related to ${entry.data.topicTitle}`
          }
          title={entry.data.topicTitle}
          loading={'eager'}
          fetchpriority={'high'}
          decoding={'async'}
          class='border-secondary aspect-video justify-self-center border-6 object-cover'
          widths={getImageWidths(processedImage.width)}
          sizes={`
            (max-width: 767px) calc(80vw - 4rem), 
            (max-width: 1300px) calc(80vw - 6rem), 1150px,
          `}
        />
      ) : null
    }
    <footer
      class='flex flex-col justify-center gap-2 self-stretch justify-self-center px-8 pt-0 pb-4 md:pt-4'
    >
      <h1
        id={'post-title'}
        class='decoration-accent text-center text-4xl font-extrabold wrap-anywhere underline underline-offset-4'
      >
        {entry.data.title}
      </h1>
      <p class='text-center text-lg font-semibold'>
        Written by: {
          entry.data.author.toLowerCase() === 'duckycoding'
            ? 'DuckyCoding (me)'
            : entry.data.author
        }
      </p>
      <div>
        <p class='text-center text-base italic'>
          Read time: {entry.data.timeToRead}
          {entry.data.timeToRead > 1 ? 'minutes' : 'minute'}
        </p>
        {
          postFromDb?.createdAt ? (
            <p class='text-center text-base italic'>
              {`Published on: ${new Date(postFromDb.createdAt).toLocaleDateString()}`}
            </p>
          ) : null
        }
      </div>
      {
        entry.data.tags.length > 0 ? (
          <div class='flex flex-wrap justify-center gap-2'>
            {entry.data.topicTitle && (
              <Link
                variant='contained'
                href={`/topics/${entry.data.topicTitle.toLowerCase()}`}
                class='border-secondary rounded-full border-none p-0'
              >
                <Tag color='accent'>{entry.data.topicTitle}</Tag>
              </Link>
            )}
            {entry.data.tags
              .filter((tag) => tag !== entry.data.topicTitle)
              .map((tag, index) => {
                return (
                  <Tag
                    class={`${index % 2 === 0 ? 'bg-accent2' : 'bg-accent'}`}
                  >
                    {tag}
                  </Tag>
                );
              })}
          </div>
        ) : null
      }
    </footer>
  </section>
  <MarkdownContent entry={entry} />
  {
    postFromDb?.updatedAt && postFromDb.updatedAt !== postFromDb?.createdAt ? (
      <p class='mt-8 text-center text-base italic'>
        {`Last updated on: ${new Date(postFromDb.updatedAt).toLocaleDateString()}`}
      </p>
    ) : postFromDb?.createdAt ? (
      <p class='mt-8 text-center text-base italic'>
        {`Published on: ${new Date(postFromDb.createdAt).toLocaleDateString()}`}
      </p>
    ) : null
  }
  <ScrollToTopButton target='#post-title' />
</HolyGrailLayout>
