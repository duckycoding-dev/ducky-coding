---
import '@styles/markdown.css';

import type { ComponentProps } from 'astro/types';
import { Image } from 'astro:assets';

import headshotDavide from '@assets/images/head-shot-davide.jpg';
import Card from '@components/card/Card.astro';
import FeatureCard from '@components/card/FeatureCard.astro';
import ProjectGrid from '@components/card/ProjectGrid.astro';
import Sticker from '@components/sticker/Sticker.astro';
import { FUN_FACTS } from '@data/fun-facts';
import { SELECTED_PROJECTS } from '@data/projects';
import { WHAT_I_DO } from '@data/what-i-do';
import HolyGrailLayout from '@layouts/holy-grail-layout/HolyGrailLayout.astro';
import {
  MY_SOCIALS_LINKS,
  WEBSITE_FIRST_PUBLISHING_DATE,
  WEBSITE_ROOT,
} from '@utils/globals';
import { buildGraph } from '@utils/json-ld/graph';
import { SiteNavigation } from '@utils/json-ld/nav';
import { DuckyCodingPerson } from '@utils/json-ld/person';
import { DuckyCodingPublisher } from '@utils/json-ld/publisher';
import { buildWebPage } from '@utils/json-ld/webpage';
import { DuckyCodingWebsite } from '@utils/json-ld/website';
import { buildPageSeo } from '@utils/seo/page-seo';
import TimelineCard from '../components/card/TimelineCard.astro';
import Link from '../components/link/Link.astro';

const timelineObjects: ComponentProps<typeof TimelineCard>[] = [
  {
    roleTitle: 'Full-stack Web Developer',
    period: '2023 - Present',
    icon: 'mdi:briefcase',
    iconTitle: 'Briefcase',
    place: 'Wavelop',
    link: 'https://wavelop.com/en',
    children: `
<p>I work on multi-company B2B applications, IoT-related products and corporate websites, with a primary focus on React and TypeScript.</p>
<p>My responsibilities span:</p>
<ul>
<li>Requirements analysis and implementation planning</li>
<li>Reusable frontend components and maintainable project structure</li>
<li>API integration and Node.js business logic</li>
<li>Unit tests, code reviews and technical documentation</li>
<li>Direct collaboration with clients</li>
</ul>
<p>Recent contributions include introducing Zod validation at AWS Lambda entry points, handling critical client-reported issues and defining the foundations of an ongoing corporate website rewrite from Next.js to Astro.</p>
<p>The stack I use the most:</p>
<ul>
<li>Frontend: React ⚛️, Next.js, Astro, Styled Components, Redux</li>
<li>Backend: Node.js and AWS Lambda with a controller-service-repository architecture, MySQL 🛢️, Jest for testing</li>
<li>Tools: TypeScript, Git</li>
</ul>
<p>I also laid the foundation for the company’s latest website using Next.js, Tailwind and Strapi 🏗️</p>`,
  },
  {
    roleTitle: 'Full-stack Web Developer Intern',
    icon: 'mdi:seed',
    iconTitle: 'Seed',
    period: 2023,
    place: 'Wavelop',
    link: 'https://wavelop.com/en',
    children:
      'During my university internship, I developed an Alexa Skill for an IoT application and contributed to existing React interfaces using TypeScript, Styled Components and Material UI.',
  },
  {
    roleTitle: "Bachelor's degree in Computer Science",
    icon: 'mdi:school',
    iconTitle: 'Graduation cap',
    period: '2019 - 2023',
    place: 'University of Padua',
    link: 'https://informatica.math.unipd.it/en/bachelor/',
    children:
      'I studied computer science fundamentals including programming, algorithms, data structures, databases, networks and software engineering, and worked on a few group projects that strengthened my problem-solving and teamwork skills.',
  },
];

const pageUrl = Astro.url.href;

// JSON-LD @graph for homepage: site identity + publisher + person + homepage + nav
const homepageJsonLd = {
  item: buildGraph([
    DuckyCodingWebsite,
    DuckyCodingPublisher,
    DuckyCodingPerson,
    buildWebPage({
      pageUrl: WEBSITE_ROOT,
      name: 'DuckyCoding',
      description:
        "Hi, I'm Davide — aka DuckyCoding. A Frontend Engineer from Italy building web applications with React and TypeScript, sharing articles, guides and memes about modern web development.",
    }),
    SiteNavigation(),
  ]),
};
---

<HolyGrailLayout
  seoProps={buildPageSeo({
    title: 'DuckyCoding',
    ogTitle: 'DuckyCoding',
    description:
      "Hi, I'm Davide — aka DuckyCoding. A Frontend Engineer from Italy building web applications with React and TypeScript, sharing articles, guides and memes about modern web development.",
    pageUrl,
    keywords:
      'DuckyCoding, Davide Milan, frontend engineer, React, TypeScript, web development, blog, projects, journey',
    article: {
      publishedTime: WEBSITE_FIRST_PUBLISHING_DATE,
      modifiedTime: WEBSITE_FIRST_PUBLISHING_DATE,
      section: 'Web Development',
      authors: ['DuckyCoding', 'Davide'],
      tags: [
        'DuckyCoding',
        'Davide Milan',
        'frontend engineer',
        'React',
        'TypeScript',
        'web development',
        'blog',
        'projects',
        'journey',
      ],
    },
  })}
  jsonLd={homepageJsonLd}
>
  <!-- Hero Section -->
  <section id='hero' class='mb-8 md:mb-12'>
    <div
      class='grid grid-cols-1 gap-8 sm:grid-cols-[repeat(auto-fit,minmax(300px,1fr))] md:grid-cols-[1fr_auto]'
    >
      <div>
        <h1
          class='text-secondary mb-6 text-3xl leading-tight font-black md:text-4xl lg:text-5xl'
        >
          Hi, I'm Davide — a <span class='text-accent-700'
            >Frontend Engineer</span
          > who writes as <span
            class='text-accent-700 wrap-break-word sm:wrap-normal'
            >DuckyCoding</span
          >
        </h1>
        <p class='text-secondary text-lg leading-relaxed md:text-xl'>
          <span
            >I build maintainable web applications with React and TypeScript,
            with full-stack experience across Node.js services and REST APIs. 🇮🇹</span
          >
          <br />
          <span
            >This is where I share what I learn, publish web-development
            articles and memes, and document the projects I build along the way.
            😃</span
          >
        </p>
        <div class='mt-6 flex flex-wrap gap-4'>
          <Link href='/my-projects' variant='contained'>
            Explore my projects 🚀
          </Link>
          <Link href='/blog' variant='outlined' class='text-secondary'>
            Read the blog 📝
          </Link>
        </div>
      </div>
      <div class='aspect-square md:h-80 lg:h-96'>
        <Card class='flex h-full w-full items-baseline md:items-baseline'>
          <Image
            format={'avif'}
            widths={[200, 300, 316, 380, 400, 600, 632, 760, 1080]}
            sizes={`
              (max-width: 664px) calc(75vw - 4rem),
              ((min-width: 665px) and (max-width: 975px)) 316px, 380px
            `}
            loading={'eager'}
            decoding={'async'}
            fetchpriority={'high'}
            title={'Davide - DuckyCoding'}
            src={headshotDavide}
            width={350}
            height={350}
            alt='Davide - DuckyCoding'
            class='h-fit w-full'
          />
        </Card>
      </div>
    </div>
  </section>

  <!-- About Cards Grid -->
  <section class='mb-16'>
    <h2 class='text-secondary mb-8 text-center text-3xl font-black md:text-4xl'>
      What I do
    </h2>
    <div class='grid grid-cols-1 gap-6 md:grid-cols-2'>
      {
        WHAT_I_DO.map((item, i) => (
          <FeatureCard
            icon={item.icon}
            iconTitle={item.iconTitle}
            index={i + 1}
            heading={item.heading}
            isWide={item.isWide}
            class={`${item.surfaceClass}${item.isWide ? ' md:col-span-2' : ''}`}
          >
            {item.body}
          </FeatureCard>
        ))
      }
    </div>
  </section>

  <!-- Fun Facts -->
  <section id='fun-facts' class='mb-16'>
    <h2 class='text-secondary mb-8 text-center text-3xl font-black md:text-4xl'>
      <span class='text-accent-700'>Fun facts</span> about me
    </h2>
    <ul class='flex list-none flex-wrap justify-center gap-4 p-0'>
      {
        FUN_FACTS.map((fact) => (
          <Sticker
            icon={fact.icon}
            iconTitle={fact.iconTitle}
            title={fact.title}
            description={fact.description}
            class={fact.surfaceClass}
          />
        ))
      }
    </ul>
  </section>

  <!-- Experience Timeline -->
  <section class='mb-16'>
    <h2 class='text-secondary mb-8 text-center text-3xl font-black md:text-4xl'>
      My <span class='text-accent-700'>journey</span> so Far
    </h2>
    <div class='space-y-8'>
      {
        timelineObjects.map((item) => (
          <TimelineCard
            icon={item.icon}
            iconTitle={item.iconTitle}
            class='block'
            roleTitle={item.roleTitle}
            period={item.period}
            place={item.place}
            link={item.link}
          >
            {typeof item.children === 'string' ? (
              item.children.trim().startsWith('<') &&
              item.children.trim().endsWith('>') ? (
                // If children is HTML, render it as HTML
                <div
                  class='markdown-content'
                  set:html={item.children}
                  class='text-secondary'
                />
              ) : (
                <p class='text-secondary'>{item.children}</p>
              )
            ) : (
              item.children
            )}
          </TimelineCard>
        ))
      }
    </div>
  </section>

  <!-- Selected Projects -->
  <section id='selected-projects' class='mb-16'>
    <h2 class='text-secondary mb-8 text-center text-3xl font-black md:text-4xl'>
      Selected <span class='text-accent-700'>projects</span>
    </h2>
    <ProjectGrid
      projects={SELECTED_PROJECTS}
      useHomeSummary
      showSecondaryLinks
      class='mx-auto max-w-4xl lg:grid-cols-2'
    />
  </section>

  <!-- CTA Section -->
  <section class='mb-16 text-center'>
    <Card class='from-accent2-100 to-accent3-100 bg-gradient-to-br p-8 md:p-12'>
      <h2 class='text-secondary mb-6 text-3xl font-black md:text-4xl'>
        Explore what I'm <span class='text-accent-700'>building</span>
      </h2>
      <p class='text-secondary mx-auto mb-8 max-w-2xl text-lg md:text-xl'>
        Browse my projects, read the latest articles or find me on GitHub and
        LinkedIn.
      </p>
      <div class='flex flex-wrap items-center justify-center gap-4'>
        <Link
          href='/my-projects'
          variant='contained'
          class='px-6 py-3 text-lg text-balance sm:text-xl'
        >
          View my projects 🚀
        </Link>
        <Link
          href='/blog'
          variant='outlined'
          class='text-secondary px-6 py-3 text-lg text-balance sm:text-xl'
        >
          Read the blog 📝
        </Link>
        <Link
          href={MY_SOCIALS_LINKS.github}
          target='_blank'
          rel='noopener noreferrer'
          variant='outlined'
          class='text-secondary border-secondary px-6 py-3 text-lg sm:text-xl'
        >
          GitHub
        </Link>
        <Link
          href={MY_SOCIALS_LINKS.linkedin}
          target='_blank'
          rel='noopener noreferrer'
          variant='outlined'
          class='text-secondary border-secondary px-6 py-3 text-lg sm:text-xl'
        >
          LinkedIn
        </Link>
      </div>
    </Card>
  </section>
</HolyGrailLayout>
