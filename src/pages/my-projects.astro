---
import type { ComponentProps } from 'astro/types';
import type { ItemList } from 'schema-dts';

import Card from '@components/card/Card.astro';
import ProjectGrid from '@components/card/ProjectGrid.astro';
import TechnologyCard from '@components/card/TechnologyCard.astro';
import LinkedInIcon from '@components/icons/linkedin-icon/LinkedInIcon.astro';
import XIcon from '@components/icons/x-icon/XIcon.astro';
import Link from '@components/link/Link.astro';
import { ALL_PROJECTS, MAIN_PROJECTS, PAST_PROJECTS } from '@data/projects';
import HolyGrailLayout from '@layouts/holy-grail-layout/HolyGrailLayout.astro';
import { WEBSITE_FIRST_PUBLISHING_DATE } from '@utils/globals';
import { buildBreadcrumb } from '@utils/json-ld/breadcrumb';
import { buildGraph } from '@utils/json-ld/graph';
import { DuckyCodingPerson } from '@utils/json-ld/person';
import { DuckyCodingPublisher } from '@utils/json-ld/publisher';
import { buildCollectionPage } from '@utils/json-ld/webpage';
import { DuckyCodingWebsite } from '@utils/json-ld/website';
import { buildPageSeo } from '@utils/seo/page-seo';

const FRONTEND_TECHNOLOGIES = [
  'React',
  'TypeScript',
  'Astro',
  'Next.js',
  'Tailwind CSS',
  'Styled Components',
  'Material UI',
  'Redux',
  'HTML',
  'Modern CSS',
];

const BACKEND_TECHNOLOGIES = [
  'Node.js',
  'Hono',
  'REST APIs',
  'AWS Lambda',
  'SQL',
  'Drizzle ORM',
  'Zod',
];

const TOOLS = [
  'Git',
  'Bun',
  'Vite',
  'Jest',
  'Docker',
  'ESLint',
  'Prettier',
  'VSCode',
];

const TECHNOLOGIES: ComponentProps<typeof TechnologyCard>[] = [
  {
    emoji: '⚛️',
    title: 'Frontend',
    description: `${FRONTEND_TECHNOLOGIES.join(', ')} and more...`,
    class: 'bg-accent-100',
  },
  {
    emoji: '💻',
    title: 'Backend',
    description: `${BACKEND_TECHNOLOGIES.join(', ')} and more...`,
    class: 'bg-accent2-100',
  },
  {
    emoji: '🔠',
    title: 'Programming languages',
    description: 'Modern JS, TypeScript, OOP with C++ and a sprinkle of PHP',
    class: 'bg-accent3-100',
  },
  {
    emoji: '🔧',
    title: 'Tools',
    description: `${TOOLS.join(', ')} and more...`,
    class: 'bg-primary-200',
  },
];

const pageUrl = Astro.url.href;

const projectsDescription =
  'Projects by Davide (DuckyCoding), Frontend Engineer — products and technical experiments exploring frontend architecture, product ideas and modern web tooling.';

const projectsItemList: ItemList = {
  '@type': 'ItemList',
  '@id': `${pageUrl}#projects`,
  name: "DuckyCoding's projects",
  numberOfItems: ALL_PROJECTS.length,
  itemListElement: ALL_PROJECTS.map((project, index) => ({
    '@type': 'ListItem' as const,
    position: index + 1,
    url: project.projectUrl,
    name: project.title,
  })),
};

const projectsPageJsonLd = {
  item: buildGraph([
    DuckyCodingWebsite,
    DuckyCodingPublisher,
    DuckyCodingPerson,
    buildCollectionPage({
      pageUrl,
      name: "DuckyCoding's projects",
      description: projectsDescription,
      hasBreadcrumb: true,
      mainEntityId: `${pageUrl}#projects`,
    }),
    projectsItemList,
    buildBreadcrumb([{ name: 'My projects', url: pageUrl }], pageUrl),
  ]),
};
---

<HolyGrailLayout
  seoProps={buildPageSeo({
    title: 'My projects',
    ogTitle: "DuckyCoding's projects",
    description: projectsDescription,
    pageUrl,
    keywords:
      'DuckyCoding, Davide Milan, projects, portfolio, frontend, React, TypeScript, Astro, PVVerdict, GitHub',
    article: {
      publishedTime: WEBSITE_FIRST_PUBLISHING_DATE,
      modifiedTime: WEBSITE_FIRST_PUBLISHING_DATE,
      section: 'Web Development',
      authors: ['DuckyCoding', 'Davide'],
      tags: [
        'DuckyCoding',
        'Davide',
        'projects',
        'portfolio',
        'web development',
        'applications',
        'GitHub',
      ],
    },
  })}
  jsonLd={projectsPageJsonLd}
>
  <!-- Hero Section -->
  <section class='mb-16 text-center'>
    <h1
      class='text-secondary mb-6 text-4xl leading-tight font-black md:text-5xl lg:text-6xl'
    >
      My <span class='text-accent-700'>projects</span>
    </h1>
    <Card
      class='from-accent3-100 to-accent2-100 mb-8 bg-gradient-to-r p-6 md:p-8'
    >
      <h2 class='text-secondary mb-4 text-2xl font-bold md:text-3xl'>
        🚀 Featured Work
      </h2>
      <p class='text-secondary mb-6'>
        A selection of products and technical experiments where I explore
        frontend architecture, product ideas and modern web tooling.
      </p>
      <div class='flex flex-wrap justify-center gap-4'>
        <Link
          rel='noopener noreferrer'
          href='#projects'
          variant='contained'
          size='large'
          class='px-8 py-4 text-2xl sm:text-3xl'
        >
          Browse projects
        </Link>
      </div>
    </Card>
  </section>

  <!-- Main Projects Grid -->
  <section id='projects' class='mb-16'>
    <h2 class='text-secondary mb-8 text-center text-3xl font-black md:text-4xl'>
      Project <span class='text-accent-700'>showcase</span>
    </h2>
    <ProjectGrid projects={MAIN_PROJECTS} eagerCount={3} />
  </section>

  <!-- Earlier Projects Grid -->
  <section id='past-projects' class='mb-16'>
    <h2 class='text-secondary mb-4 text-center text-3xl font-black md:text-4xl'>
      Earlier <span class='text-accent-700'>projects</span>
    </h2>
    <p class='text-secondary mx-auto mb-8 max-w-2xl text-center'>
      Older experiments, university work and small tools I built along the way.
    </p>
    <ProjectGrid projects={PAST_PROJECTS} />
  </section>

  <!-- Technologies Section -->
  <section id='technologies' class='mb-16'>
    <h2 class='text-secondary mb-8 text-center text-3xl font-black md:text-4xl'>
      Technologies I <span class='text-accent-700'>USE</span>
    </h2>
    <div class='grid grid-cols-1 gap-6 md:grid-cols-2 lg:grid-cols-4'>
      {TECHNOLOGIES.map((tech) => <TechnologyCard {...tech} />)}
    </div>
  </section>

  <!-- Contact CTA -->
  <section class='text-center'>
    <Card class='from-accent-100 to-accent3-100 bg-gradient-to-br p-8 md:p-12'>
      <h2 class='text-secondary mb-6 text-3xl font-black md:text-4xl'>
        Let's build something amazing!
      </h2>
      <p class='text-secondary mx-auto mb-8 max-w-2xl text-lg md:text-xl'>
        This is just a glimpse of my work.
        <br />
        If you're interested in collaborating, have a project idea, or just want to
        chat about tech, I'd love to hear from you!
      </p>
      <div class='flex justify-center gap-4'>
        <Link
          target='_blank'
          href='https://x.com/ducky_coding'
          variant={'outlined'}
          class='text-secondary border-secondary'
          rel='noopener noreferrer'
        >
          <XIcon size={50} />
        </Link>
        <Link
          target='_blank'
          href='https://www.linkedin.com/in/davide-m-997874254/'
          variant={'outlined'}
          class='text-secondary border-secondary'
          rel='noopener noreferrer'
        >
          <LinkedInIcon size={50} />
        </Link>
      </div>
    </Card>
  </section>
</HolyGrailLayout>

<style>
  @keyframes float {
    0%,
    100% {
      transform: translateY(0px);
    }
    50% {
      transform: translateY(-10px);
    }
  }

  /* Add floating animation to fun facts cards on larger screens */
  @media (min-width: 768px) {
    #technologies > div > :nth-child(1) {
      animation: float 3s ease-in-out infinite;
      animation-delay: 0s;
    }
    #technologies > div > :nth-child(2) {
      animation: float 3s ease-in-out infinite;
      animation-delay: 0.5s;
    }
    #technologies > div > :nth-child(3) {
      animation: float 3s ease-in-out infinite;
      animation-delay: 1s;
    }
    #technologies > div > :nth-child(4) {
      animation: float 3s ease-in-out infinite;
      animation-delay: 1.5s;
    }
  }

  @media (prefers-reduced-motion) {
    #technologies > div > :nth-child(n) {
      animation: none;
    }
  }
</style>
