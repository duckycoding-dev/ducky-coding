{
  "version": "0.0.1",
  "name": "ducky-coding-dev",
  "author": "DuckyCoding <duckycoding.dev@gmail.com>",
  "description": "Ducky Codings's blog website, built with Astro",
  "private": true,
  "license": "MIT",
  "type": "module",
  "keywords": [
    "duckycoding",
    "webdev",
    "astro",
    "drizzle"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/duckycoding-dev/ducky-coding.git"
  },
  "bugs": {
    "url": "https://github.com/duckycoding-dev/ducky-coding/issues"
  },
  "files": [
    "dist"
  ],
  "main": "dist/index.html",
  "engines": {
    "node": ">=22.6"
  },
  "packageManager": "npm@11.11.0",
  "scripts": {
    "prepare": "husky",
    "astro:check": "astro check",
    "astro:dev": "astro dev",
    "astro:build": "astro check && astro build --mode production",
    "astro:build:local": "astro build --mode development",
    "astro:preview": "astro preview",
    "db:migrate:local": "node --env-file=.env.development ./src/db/migrate.ts",
    "db:migrate": "node --env-file=.env.production ./src/db/migrate.ts",
    "drizzle:generate_migrations": "drizzle-kit generate",
    "drizzle:studio": "npx drizzle-kit studio",
    "drizzle:seed": "node --env-file=.env.development ./src/db/seed.ts",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@astrojs/mdx": "7.0.5",
    "@astrojs/netlify": "8.2.0",
    "@astrojs/rss": "4.0.19",
    "@astrojs/sitemap": "3.7.3",
    "@iconify-json/mdi": "1.2.3",
    "@iconify-json/ph": "1.2.2",
    "@libsql/client": "0.17.4",
    "@tailwindcss/vite": "4.3.3",
    "astro": "7.2.0",
    "astro-icon": "1.1.5",
    "astro-seo": "1.1.0",
    "astro-seo-schema": "7.0.0",
    "clsx": "2.1.1",
    "cva": "1.0.0-beta.4",
    "drizzle-orm": "0.45.2",
    "drizzle-zod": "0.8.3",
    "markdown-it": "15.0.0",
    "sanitize-html": "2.17.6",
    "schema-dts": "1.1.5",
    "tailwind-merge": "3.6.0",
    "tailwindcss": "4.3.3",
    "yaml": "2.9.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@commitlint/cli": "21.2.1",
    "@commitlint/config-conventional": "21.2.0",
    "@types/markdown-it": "14.1.2",
    "@types/sanitize-html": "2.16.1",
    "drizzle-kit": "0.31.10",
    "eslint": "10.8.1",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-astro": "1.7.0",
    "eslint-plugin-import-x": "4.17.1",
    "eslint-plugin-prettier": "5.5.6",
    "eslint-plugin-simple-import-sort": "14.0.0",
    "eslint-plugin-unused-imports": "4.4.1",
    "husky": "9.1.7",
    "lint-staged": "17.3.0",
    "prettier": "3.9.6",
    "prettier-plugin-astro": "0.14.1",
    "prettier-plugin-tailwindcss": "0.8.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.66.0",
    "vitest": "4.1.10"
  }
}
