{
  "version": "0.0.1",
  "name": "ducky-coding-dev",
  "author": "DuckyCoding <duckycoding.dev@gmail.com>",
  "description": "Ducky Codings's blog website, built with Astro",
  "private": true,
  "license": "MIT",
  "type": "module",
  "keywords": [
    "duckycoding",
    "webdev",
    "astro",
    "drizzle"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/duckycoding-dev/ducky-coding.git"
  },
  "bugs": {
    "url": "https://github.com/duckycoding-dev/ducky-coding/issues"
  },
  "files": [
    "dist"
  ],
  "main": "dist/index.html",
  "scripts": {
    "prepare": "husky",
    "astro:check": "astro check",
    "astro:dev": "astro dev",
    "astro:build": "astro check && astro build",
    "astro:build:local": "astro build --mode development",
    "astro:preview": "astro preview",
    "db:migrate:local": "node --env-file=.env.development ./src/db/migrate.ts",
    "db:migrate": "node --env-file=.env.production ./src/db/migrate.ts",
    "drizzle:generate_migrations": "drizzle-kit generate",
    "drizzle:studio": "npx drizzle-kit studio",
    "drizzle:seed": "node --env-file=.env.development ./src/db/seed.ts",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@astrojs/check": "0.9.8",
    "@astrojs/mdx": "5.0.3",
    "@astrojs/netlify": "7.0.5",
    "@astrojs/rss": "4.0.18",
    "@astrojs/sitemap": "3.7.2",
    "@iconify-json/mdi": "1.2.3",
    "@iconify-json/ph": "1.2.2",
    "@libsql/client": "0.17.2",
    "@tailwindcss/vite": "4.2.2",
    "astro": "6.1.2",
    "astro-icon": "1.1.5",
    "astro-seo": "1.1.0",
    "astro-seo-schema": "6.0.0",
    "clsx": "2.1.1",
    "cva": "1.0.0-beta.4",
    "drizzle-kit": "0.31.10",
    "drizzle-orm": "0.45.2",
    "drizzle-zod": "0.8.3",
    "markdown-it": "14.1.1",
    "sanitize-html": "2.17.2",
    "schema-dts": "1.1.5",
    "tailwind-merge": "3.5.0",
    "tailwindcss": "4.2.2"
  },
  "devDependencies": {
    "@commitlint/cli": "20.5.0",
    "@commitlint/config-conventional": "20.5.0",
    "@types/markdown-it": "14.1.2",
    "@types/sanitize-html": "2.16.1",
    "eslint": "10.1.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-astro": "1.6.0",
    "eslint-plugin-import-x": "4.16.2",
    "eslint-plugin-prettier": "5.5.5",
    "eslint-plugin-simple-import-sort": "12.1.1",
    "eslint-plugin-unused-imports": "4.4.1",
    "husky": "9.1.7",
    "lint-staged": "16.4.0",
    "prettier": "3.8.1",
    "prettier-plugin-astro": "0.14.1",
    "prettier-plugin-tailwindcss": "0.7.2",
    "typescript": "5.9.3",
    "typescript-eslint": "8.58.0"
  }
}
