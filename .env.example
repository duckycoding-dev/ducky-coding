# Copy to .env.development for local work
# (see docs/stable/development/build-flow.md for the full setup)

# Public site origin, used for canonical URLs, sitemap and RSS
BASE_SITE_URL=http://localhost:4321

# Log verbosity: log | info | warn | error | debug (see src/utils/logs/logger.ts)
SERVER_LOGS_LEVEL=info
CLIENT_LOGS_LEVEL=info

# Local: file-based SQLite. Production uses a hosted Turso URL + auth token.
TURSO_DATABASE_URL=file:database/content.db
TURSO_AUTH_TOKEN=

# run | skip — 'skip' builds the site without migrating or syncing any database
DB_SYNC=run
